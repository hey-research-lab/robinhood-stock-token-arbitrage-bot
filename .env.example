# Copy to .env and fill locally. Never commit .env.

# Required for onchain reads (multiplier, Chainlink). No public fallback is bundled.
# Providers that list Robinhood Chain (chain ID 4663): Chainstack, QuickNode, Dwellir.
ROBINHOOD_RPC_URL=

# Paper trading is the default. LIVE_TRADING=true is the only switch that can
# submit Uniswap CLASSIC swaps, and only after the risk engine allows.
LIVE_TRADING=false

# Stock Tokens are restricted for US, UK, Canadian, and Swiss persons.
# Market-data collection and paper simulation may run regardless.
# The strategy/execution loop will not start unless ELIGIBLE_PERSON=true
# and JURISDICTION is set to a non-blocked ISO 3166-1 alpha-2 code.
ELIGIBLE_PERSON=false
JURISDICTION=

# Watchlist only — never "all active" assets.
SYMBOLS=AAPL,NVDA,MSFT,AMZN,GOOGL,META,TSLA,AVGO,UNH,SPY

# Quote asset: USDG on Robinhood Chain.
# Verified 2026-09-15 on https://robinhoodchain.blockscout.com/token/0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
#   symbol=USDG (Global Dollar), decimals=6, holders≈345k, transfers≈203M, reputation=ok
# Fake tokens named "USDG" exist on this chain. Match the full address, not the ticker.
QUOTE_TOKEN_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
QUOTE_TOKEN_SYMBOL=USDG
QUOTE_TOKEN_DECIMALS=6

# Staleness. REST /rhj/prices is cached ~15s. Chainlink equity feeds are 24/5 and
# will often fail a 5s check outside prints — raise CHAINLINK_MAX_AGE_MS after you
# observe real heartbeats; do not disable staleness checks.
ONCHAIN_MAX_AGE_MS=5000
REST_MAX_AGE_MS=20000
CHAINLINK_MAX_AGE_MS=5000

# Placeholder risk limits (paper-mode scaffolding only; not advice).
MAX_POSITION_PER_SYMBOL_USD=500
MAX_SINGLE_TRADE_USD=200
MAX_DAILY_LOSS_USD=250
MIN_NET_EDGE_BPS=50
MAX_SLIPPAGE_BPS=30
RISK_BUFFER_BPS=10
MIN_NET_EDGE_USD=0.5
OPPORTUNITY_TTL_MS=5000

# Gas is always in the cost model. Used when a CLASSIC Uniswap quote omits gasFeeUSD.
# Do not set this to 0 to "model" the launch subsidy — UniswapX quotes may legitimately
# report 0 gas for the swapper; CLASSIC routes must still cost something.
ESTIMATED_GAS_USD=0.05

# Uniswap Trading API (https://developers.uniswap.org/). Quotes stay stubbed if empty.
UNISWAP_API_KEY=

# Optional address used only as Trading API `swapper` on quote calls (not a key).
# QUOTE_SWAPPER=

# Optional: local JSON of Chainlink proxy addresses you copied from official docs.
# Do not point this bot at unofficial feed-directory mirrors.
CHAINLINK_FEEDS_FILE=./config/chainlink-feeds.json

# Optional per-symbol overrides (win over the JSON file).
# Copy proxy addresses from:
#   https://docs.chain.link/data-feeds/tokenized-equity-feeds/robinhood
#   https://docs.chain.link/data-feeds/price-feeds/addresses  (network: Robinhood)
#   https://docs.robinhood.com/chain/oracles-and-price-feeds/
# CHAINLINK_FEED_AAPL=0x...
# CHAINLINK_FEED_NVDA=0x...

# Optional L2 sequencer uptime feed (leave empty until you confirm the 4663 address).
CHAINLINK_SEQUENCER_UPTIME_FEED=

# Live path only. Never commit a real key. Prefer a KMS reference later (not implemented).
# WALLET_PRIVATE_KEY=
# WALLET_KMS_REF=

# Phase 5 persistence, file logs, pending-tx timeout, optional Slack on kill-switch.
SQLITE_PATH=./data/bot.sqlite
LOG_FILE=./logs/bot.jsonl
PENDING_TX_TIMEOUT_MS=900000
# SLACK_WEBHOOK_URL=
